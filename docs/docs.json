{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "ephemera",
  "description": "Run commands, dev servers and coding agents in throwaway microVMs on your own machines.",
  "colors": {
    "primary": "#EFEDE6",
    "light": "#EFEDE6",
    "dark": "#EFEDE6"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ephemera.run"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Satoshi",
    "source": "https://ephemera.mintlify.site/docs/fonts/Satoshi-Variable.woff2",
    "format": "woff2"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#121212",
      "dark": "#121212"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "ephemera.run",
        "href": "https://ephemera.run"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://ephemera.run/login"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "guides/agents",
          "how-it-works"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/run",
          "guides/dev",
          "guides/network",
          "guides/sandbox",
          "guides/setup",
          "guides/records",
          "guides/hosts",
          "guides/one-machine",
          "guides/tokens",
          "self-hosting/index",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/host",
          "reference/server",
          "reference/api",
          "reference/configuration",
          "reference/install",
          "self-hosting/operate",
          "security",
          "changelog"
        ]
      }
    ]
  },
  "footer": {
    "links": [
      {
        "header": "ephemera",
        "items": [
          {
            "label": "ephemera.run",
            "href": "https://ephemera.run"
          },
          {
            "label": "Dashboard",
            "href": "https://ephemera.run/dashboard"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/pyjeebz/ephemera"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "canonical": "https://ephemera.run/docs"
    }
  }
}
